{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test --experimental-test-isolation=none tests/unit/*.test.js"
  },
  "mutate": [
    "js/lang.js",
    "js/chrono.js",
    "js/stats.js",
    "js/settings.js",
    "js/annex.js",
    "js/formation.js",
    "js/html.js",
    "js/journal.js",
    "js/mic-watch.js",
    "js/voice.js",
    "js/speech.js",
    "js/update.js",
    "scripts/lib/publication.js",
    "scripts/lib/etat-publication.js",
    "scripts/lib/corpus.js",
    "scripts/lib/cloud.js"
  ],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 80
  },
  "concurrency": 4,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always"
}
