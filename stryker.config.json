{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test --experimental-test-isolation=none tests/unit/*.test.js"
  },
  "mutate": [
    "js/lang.js",
    "js/chrono.js",
    "js/stats.js",
    "js/settings.js",
    "js/annex.js",
    "js/html.js",
    "js/journal.js",
    "js/mic-watch.js",
    "js/voice.js",
    "js/speech.js"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "concurrency": 4,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always"
}
