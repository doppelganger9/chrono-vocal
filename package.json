{
  "name": "chrono-vocal",
  "private": true,
  "description": "Chrono vocal pour la canne de combat",
  "scripts": {
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "serve": "node tests/server.js",
    "coverage": "node scripts/coverage.js",
    "mutation": "stryker run",
    "avant-apres": "node scripts/avant-apres.js",
    "pr-assets": "node scripts/pr-assets.js",
    "ai-stats": "node scripts/ai-stats.js",
    "typecheck": "tsc -p jsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@stryker-mutator/core": "10.0.0",
    "monocart-coverage-reports": "2.13.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@babel/traverse": "7.29.8"
  }
}
