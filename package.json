{
  "name": "chrono-vocal",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "description": "Chrono vocal pour la canne de combat",
  "scripts": {
    "pretest": "node scripts/check-node.js",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e",
    "verifier": "node scripts/verifier.js",
    "pr-body": "node scripts/pr-body.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "serve": "node tests/server.js",
    "coverage": "node scripts/coverage.js",
    "mutation": "stryker run",
    "avant-apres": "node scripts/avant-apres.js",
    "pr-assets": "node scripts/pr-assets.js",
    "ai-stats": "node scripts/ai-stats.js",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@stryker-mutator/core": "10.0.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "monocart-coverage-reports": "2.13.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
